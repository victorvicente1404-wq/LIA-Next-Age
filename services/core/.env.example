# Optional overrides. No hosted AI provider keys are required.
LIA_RUNTIME_BACKEND=auto
LIA_LLM_BASE_URL=http://127.0.0.1:8080/v1
LIA_LLM_MODEL=local-model
LIA_LLM_TIMEOUT=120
LIA_DATA_DIR=~/.lia

# Optional path-separated allowlist for Lia Dev (use absolute paths).
# Android/Linux example:
# LIA_DEV_WORKSPACES=/data/data/com.termux/files/home/projects/LIA-Next-Age

# Optional local speech recognition (whisper.cpp server; loopback only)
LIA_VOICE_STT_URL=http://127.0.0.1:8178/inference
LIA_VOICE_TIMEOUT=90
LIA_VOICE_MAX_AUDIO_BYTES=20971520

# Optional local speech synthesis (Piper CLI + downloaded voice model)
LIA_PIPER_BIN=
LIA_PIPER_MODEL=
